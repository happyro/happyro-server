[Unit]
Description=HappyRO char server
After=happyro-login-server.service
Requires=happyro-login-server.service

[Service]
Type=simple
User=happyro
Group=happyro
WorkingDirectory=/vol2/1000/kugarocks/happyro/repos/happyro-server
ExecStart=/vol2/1000/kugarocks/happyro/repos/happyro-server/char-server
# Override via systemctl edit; allowed values: ship, classic.
Environment=HAPPYRO_NEW_PLAYER_START=classic
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
