[Unit]
Description=HappyRO map server
After=happyro-char-server.service
Requires=happyro-char-server.service

[Service]
Type=simple
User=happyro
Group=happyro
UMask=0007
WorkingDirectory=/vol2/1000/kugarocks/happyro/repos/happyro-server
RuntimeDirectory=happyro
RuntimeDirectoryMode=0750
ExecStart=/vol2/1000/kugarocks/happyro/repos/happyro-server/map-server
# Override HAPPYRO_AREA_SIZE / HAPPYRO_MAX_WALK_PATH via systemctl edit.
# Empty or unset values use battle configuration (defaults: 18 / 17).
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
